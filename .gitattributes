# Enforce LF line endings across all platforms and containers
* text=auto eol=lf

# Explicit text files
*.sh text eol=lf
*.py text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.conf text eol=lf
*.toml text eol=lf
*.ini text eol=lf
*.sql text eol=lf
*.txt text eol=lf
Dockerfile* text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.tar.gz binary
*.tgz binary
*.zip binary
*.pyc binary
