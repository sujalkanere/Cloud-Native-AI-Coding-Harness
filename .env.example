# ==============================================================================
# Cloud-Native AI Coding Harness - Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment Mode
# ------------------------------------------------------------------------------
# Options: development | test | production
# - development: Default for docker compose; uses dev auth and local services bound to localhost.
# - test: Required when running automated test suites and ScriptedLLMProvider.
# - production: Strictly refuses dev auth (AUTH_PROVIDER=dev) and scripted LLM (LLM_PROVIDER=scripted).
HARNESS_ENV=development

# ------------------------------------------------------------------------------
# 2. LLM Provider Configuration
# ------------------------------------------------------------------------------
# Options: anthropic | openai | scripted | [blank]
# - blank: Infers provider based on whichever API key is set.
# - scripted: Accepted only when HARNESS_ENV=test.
LLM_PROVIDER=

# Pinned default model (leave blank to use provider default: claude-3-7-sonnet-20250219 or gpt-4o)
LLM_MODEL=

# Anthropic Configuration
ANTHROPIC_API_KEY=

# OpenAI Configuration
OPENAI_API_KEY=
OPENAI_BASE_URL=

# ------------------------------------------------------------------------------
# 3. Authentication Configuration
# ------------------------------------------------------------------------------
# Options: dev | clerk
# - dev: Fixed developer user (bypasses auth headers); prohibited in production.
# - clerk: Validates JWT against CLERK_JWKS_URL and CLERK_ISSUER.
AUTH_PROVIDER=dev
CLERK_JWKS_URL=
CLERK_ISSUER=

# ------------------------------------------------------------------------------
# 4. Database Configuration (PostgreSQL 16 Async)
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/harness

# ------------------------------------------------------------------------------
# 5. Object Storage Configuration (MinIO / S3 Compatible)
# ------------------------------------------------------------------------------
# S3_ENDPOINT_URL: Internal container endpoint for backend storage adapter.
# S3_PUBLIC_ENDPOINT_URL: Public host endpoint used to generate presigned URLs accessible from browser.
S3_ENDPOINT_URL=http://minio:9000
S3_PUBLIC_ENDPOINT_URL=http://127.0.0.1:9000
S3_BUCKET=harness-artifacts
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1

# ------------------------------------------------------------------------------
# 6. Docker Daemon Proxy Connection
# ------------------------------------------------------------------------------
# Backend reaches Docker daemon exclusively through docker-socket-proxy.
DOCKER_HOST=tcp://docker-proxy:2375

# ------------------------------------------------------------------------------
# 7. Sandbox Container Specification & Hardening
# ------------------------------------------------------------------------------
SANDBOX_IMAGE=harness-sandbox:latest
SANDBOX_NETWORK_MODE=none
SANDBOX_CPU_LIMIT=1.0
SANDBOX_MEM_LIMIT=1g
SANDBOX_PIDS_LIMIT=256
SANDBOX_WARM_POOL_SIZE=2

# Tmpfs Mount Headroom Configuration:
# Total tmpfs memory (SANDBOX_WORKSPACE_SIZE + SANDBOX_TMP_SIZE) MUST NOT exceed 60% of SANDBOX_MEM_LIMIT.
# Default calculation: 384m + 128m = 512m = exactly 50.0% of 1g (<= 60%).
SANDBOX_WORKSPACE_SIZE=384m
SANDBOX_TMP_SIZE=128m

# ------------------------------------------------------------------------------
# 8. Harness Orchestration & Concurrency Limits
# ------------------------------------------------------------------------------
MAX_CONCURRENT_RUNS=4
AGENT_MAX_STEPS=40
AGENT_MAX_TOKENS=200000
AGENT_MAX_CONSECUTIVE_FAILURES=5
COMMAND_TIMEOUT_SECONDS=120
MAX_UPLOAD_MB=50
MAX_OUTPUT_BYTES_PER_RUN=5242880
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
